---
import { Image } from "astro:assets";
import Layout from "../components/layout/layout.astro";
import { getHomePageData } from "../services/home";

const { titleHero, description, heroImage } = await getHomePageData();
---

<Layout title="Cubo P9 - Inicio">
  <header>
    <h1>{titleHero}</h1>
    <p>{description}</p>
    <Image
      width={heroImage.width}
      height={heroImage.height}
      src={heroImage.url}
      alt={heroImage.alternativeText || "Hero image"}
    />
  </header>
</Layout>
