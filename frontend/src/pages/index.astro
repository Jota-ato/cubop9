---
import Layout from "../components/layout/layout.astro";
import { fetchStrapi } from "../lib/strapi.ts";

let response = null;

try {
  response = await fetchStrapi("/home-page");
  console.log("Datos de Strapi:", response);
} catch (error) {
  console.error("Error al conectar con Strapi:", error);
}

console.log("Suma:", 2 + 2);
---

<Layout title="My Astro App">
  <header>
    <h1>{response.title}</h1>
  </header>
  <main>
    <pre>{JSON.stringify(response, null, 2)}</pre>
  </main>
</Layout>
